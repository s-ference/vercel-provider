{
  "name": "@sference/vercel-provider",
  "version": "0.1.1",
  "description": "Vercel AI SDK v4 provider for the sference managed-inference API (realtime OpenAI-compatible /v1/chat/completions).",
  "type": "module",
  "license": "Apache-2.0",
  "author": "sference <hello@sference.com> (https://sference.com)",
  "homepage": "https://sference.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-ference/vercel-provider.git"
  },
  "bugs": {
    "url": "https://github.com/s-ference/vercel-provider/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.0",
    "@ai-sdk/provider-utils": "^5.0.0",
    "eventsource-parser": "^3.0.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.3",
    "@ai-sdk/provider-utils": "^5.0.11",
    "@types/node": "^26.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0 || ^3.0.0",
    "zod": "^3.23.0"
  },
  "keywords": [
    "ai-sdk",
    "ai-sdk-provider",
    "vercel-ai-sdk",
    "sference",
    "llm",
    "inference",
    "open-models"
  ]
}
